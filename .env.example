# ---------------------------------------------------------------------------
# Cloudflare Turnstile — contact form bot protection
# Create a widget at: Cloudflare Dashboard → Turnstile → Add widget
# ---------------------------------------------------------------------------

# Public site key. Rendered in the browser; safe to expose.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Secret key. Server-only — never prefix with NEXT_PUBLIC_.
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# GoHighLevel contact webhook (optional)
# Falls back to the hardcoded default in app/api/contact/route.ts if unset.
# ---------------------------------------------------------------------------
GHL_CONTACT_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Cloudflare's documented always-pass test keys, for local development:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Always-fail (for testing the rejection path):
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=2x00000000000000000000AB
#   TURNSTILE_SECRET_KEY=2x0000000000000000000000000000000AA
# ---------------------------------------------------------------------------
